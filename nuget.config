<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NexusCore packages come from ./packages (built from the Core repository with
       eng/pack-core-modules.ps1); everything else from nuget.org. In a bank network, replace
       nuget.org with the approved internal feed. -->
  <packageSources>
    <clear />
    <add key="NexusCore (local)" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="NexusCore (local)">
      <package pattern="NexusCore.*" />
      <package pattern="Nexus.*" />
      <package pattern="Chat.*" />
      <package pattern="Notifications.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
