{
  // This file is the ONE place a deployment sets its own environment - loaded automatically
  // whenever ASPNETCORE_ENVIRONMENT is unset or "Production" (the default for a real install
  // outside an IDE launch profile). Nothing in appsettings.json (the base, environment-
  // independent file) or in source needs to change for a new deployment; only the values below.
  // See DEPLOYMENT-CONFIG.md for the full install walkthrough.

  // The exact origin(s) the frontend is served from, e.g. "https://192.168.x.x:3030" or
  // "https://your-domain.example". Required - CORS rejects every request otherwise. Same-origin
  // deployments (frontend and API behind one reverse-proxy address) can leave this empty.
  "Cors": {
    "AllowedOrigins": []
  },

  // ---- Security: DEPLOYMENT-CONFIG.md section 10. Fill in at a real install. -----------------
  // Every value below is safe as it stands; empty means "not used here". The site-wide defaults
  // (session, rate limits, organization separation, log levels) are in appsettings.json - to
  // change one, add only that key here, e.g.
  //   "NexusCore": { "RateLimiting": { "Global": { "PermitLimit": 900 } } }

  "NexusCore": {
    // 10.1 The reverse proxy in front of this API (IIS ARR, nginx): its address(es), or its
    // network in CIDR form ("10.0.1.0/24"). X-Forwarded-For is believed only from these. Empty:
    // only this machine is trusted - behind a proxy every user would then count as the proxy and
    // share one rate-limit quota, so set it whenever there is a proxy.
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": [],
      // How many proxies are chained in front of the API.
      "ForwardLimit": 1
    }
  },

  // 10.3 Folder of the encryption keys of the stored SMS key / LDAP password, e.g.
  // "D:\\Keys\\TejaratBank": outside the application folder, writable by the application pool
  // identity only, and backed up. Copy the keys the app uses now into it before the first start.
  // Empty: the API starts with a warning and the keys may be lost on a restart.
  "DataProtection": {
    "KeysPath": ""
  },

  "Security": {
    // 10.4 Where administrators may point the server. AllowedHosts: in-house SMS gateway hosts
    // besides the provider's own, exact or "*.suffix" (e.g. "sms.bank.local", "*.gw.bank.local");
    // AllowHttp: plain http for those hosts only. LdapAllowedHosts: when set, the only LDAP servers
    // allowed (the allowed LDAP ports are 389, 636, 3268, 3269 unless LdapAllowedPorts is set).
    "OutboundAddresses": {
      "AllowedHosts": [],
      "AllowHttp": false,
      "LdapAllowedHosts": []
    },
    // 10.5 Organization separation in the database layer stays on (appsettings.json). Emergency
    // only: one context off, e.g. "DisabledContexts": [ "ChatDbContext" ].
    "TenantFilter": {
      "DisabledContexts": []
    }
  }

  // Real database server for this deployment, e.g. "Server=192.168.x.x;Database=TejaratBank;...".
  // Leave the ConnectionStrings section absent here to keep using appsettings.json's local
  // default ("Server=.", i.e. this same machine), or set it here to point elsewhere.
  // "ConnectionStrings": {
  //   "DefaultConnection": "Server=<db-host>;Database=TejaratBank;Trusted_Connection=True;TrustServerCertificate=True;",
  //   "Chat": "Server=<db-host>;Database=TejaratBank;Trusted_Connection=True;TrustServerCertificate=True;"
  // }

  // Jwt:SigningKey is NOT set here and must never be committed. Set it via the Jwt__SigningKey
  // environment variable (IIS: applicationHost.config / web.config <environmentVariables>, or the
  // App Pool's environment). The app fails fast at startup if this is missing, a known
  // placeholder, or under 32 characters - see the check in Program.cs.
}
