{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=TejaratBank;Trusted_Connection=True;TrustServerCertificate=True;",
    "Chat": "Server=.;Database=TejaratBank;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "TejaratBank",
    "Audience": "TejaratBank",
    // Short, because an access token cannot be revoked before it expires.
    "AccessTokenMinutes": 15
  },
  // Sign-in sessions (DEPLOYMENT-CONFIG.md 10.2). The refresh token lives only in the HttpOnly
  // cookie; a sign-in ends after RefreshTokenDays whatever the refreshes, and an exchanged token
  // shown again after ReuseGraceSeconds ends the whole sign-in.
  "Identity": {
    "Session": {
      "RefreshTokenDays": 14,
      "ReuseGraceSeconds": 10,
      "RefreshCookieName": "nexus_rt",
      "ReturnRefreshTokenInBody": false,
      "AcceptRefreshTokenInBody": false
    }
  },
  // Rate limits (DEPLOYMENT-CONFIG.md 10.1): requests per WindowMinutes, per signed-in user or,
  // when anonymous, per client address. Override single values in appsettings.Production.json.
  "NexusCore": {
    "RateLimiting": {
      "Enabled": true,
      "Global": { "PermitLimit": 600, "WindowMinutes": 1 },
      "Auth": { "PermitLimit": 10, "WindowMinutes": 1 },
      "PasswordRecovery": { "PermitLimit": 5, "WindowMinutes": 15 },
      "PasswordResetVerification": { "PermitLimit": 10, "WindowMinutes": 15 },
      "AuthenticatedApi": { "PermitLimit": 300, "WindowMinutes": 1 },
      "Write": { "PermitLimit": 120, "WindowMinutes": 1 },
      "Upload": { "PermitLimit": 20, "WindowMinutes": 5 },
      "ChatSend": { "PermitLimit": 60, "WindowMinutes": 1 },
      "Sms": { "PermitLimit": 5, "WindowMinutes": 5 },
      "Realtime": { "PermitLimit": 120, "WindowMinutes": 1 },
      "SecurityReports": { "PermitLimit": 30, "WindowMinutes": 1 }
    }
  },
  // Organization separation in the database layer (DEPLOYMENT-CONFIG.md 10.5). false only in an
  // emergency; to switch off one context set Security:TenantFilter:DisabledContexts in
  // appsettings.Production.json. Lists (DisabledContexts, the OutboundAddresses hosts) are not set
  // here: configuration merges lists item by item, so a list here would mix with the site's own.
  "Security": {
    "TenantFilter": {
      "Enabled": true
    },
    "OutboundAddresses": {
      "AllowHttp": false
    }
  },
  // Encryption keys of the stored SMS key and LDAP password (DEPLOYMENT-CONFIG.md 10.3). The
  // folder itself (DataProtection:KeysPath) is set per site in appsettings.Production.json.
  "DataProtection": {
    "ApplicationName": "TejaratBank",
    "ProtectWithDpapi": true
  },
  // ASP.NET Core's own request log writes the full address, query string included - and SignalR
  // sends its access token there (/hubs/...?access_token=). It is kept to warnings; every request
  // is still logged once, without the query string, by UseSerilogRequestLogging.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Database": {
    "SeedOnStartup": true,
    // Organization / OrgStructure schemas: created on a new database and brought up to date on an
    // existing one at start-up. false: a DBA runs the scripts in db/ instead (DEPLOYMENT-CONFIG.md).
    "InitializeOrgStructureSchema": true
  },
  "Features": {
    "UserGroups": {
      "Enabled": true
    }
  },
  // Tasks only to one's own level and below in the org chart (people with no place yet are free;
  // the permission «ارجاع فعالیت به همه‌ی سطوح سازمانی» lifts it). false: anyone to anyone.
  "OrgStructure": {
    "LimitTaskAssignment": true,
    // Tasks are given to posts, not people: when a post changes hands its tasks go with it.
    "AssignTasksToPosts": true,
    // Everyone sees, messages and gives tasks only to their own company (the permission «دسترسی
    // به همه‌ی شرکت‌ها» lifts it). false: the companies are open to one another.
    "LimitToOwnCompany": true
  },
  // Recurring tasks, due-soon / overdue reminders and SMS held for the quiet hours.
  "TaskManagement": {
    "Scheduler": {
      "Enabled": true
    }
  },
  // Cors:AllowedOrigins is deliberately not set here - it's environment-specific, so it belongs
  // in appsettings.Development.json (dev origins) or appsettings.Production.json (the real
  // deployment's origin, set at install time). See DEPLOYMENT-CONFIG.md.
  "AllowedHosts": "*"
}
